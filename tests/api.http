@baseUrl = http://localhost:5000/api

### 1. Health Check
GET http://localhost:5000/health

### 2. Register User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "name": "Testing User",
    "email": "testing@example.com",
    "password": "password123",
    "phone": "081234567890"
}

### 3. Login User
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "testing@example.com",
    "password": "password123"
}

### 4. Get Profile (Protected)
@token = {{login.response.body.data.token}}
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### 5. Login Admin
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "admin@homestay.com",
    "password": "admin123"
}

@adminToken = {{loginAdmin.response.body.data.token}}

### 6. Public - Get Facilities
GET {{baseUrl}}/facilities

### 7. Public - Get Rooms (Catalog)
GET {{baseUrl}}/rooms

### 8. Public - Get Featured Rooms
GET {{baseUrl}}/rooms?featured=true

### 9. Public - Get Room Detail
GET {{baseUrl}}/rooms/1

### 9b. Public - Search Available Rooms (M3 - SF-4, BR-03, BR-04, BR-05)
GET {{baseUrl}}/rooms/available?check_in=2026-12-01&check_out=2026-12-04&guests=2

### 9c. Public - Get Room Availability Calendar by Month (M3 - SF-4, BR-18)
GET {{baseUrl}}/rooms/1/availability?month=2026-12

### 10. Admin - Get All Facilities
GET {{baseUrl}}/admin/facilities
Authorization: Bearer {{adminToken}}

### 11. Admin - Create Facility
POST {{baseUrl}}/admin/facilities
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "name": "Kolam Renang",
    "icon": "waves"
}

### 12. Admin - Get All Rooms
GET {{baseUrl}}/admin/rooms
Authorization: Bearer {{adminToken}}

### 13. Admin - Create Room
POST {{baseUrl}}/admin/rooms
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "name": "Kamar Suite Sunset",
    "description": "Kamar dengan pemandangan matahari terbenam yang indah",
    "pricePerNight": 750000,
    "capacity": 3,
    "status": "Available",
    "facilityIds": [1, 2]
}

### 14. Guest - Create Reservation with Row Lock (M4 - SF-6, BR-07)
# @name createReservation
POST {{baseUrl}}/reservations
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "room_id": 1,
    "check_in_date": "2026-12-20",
    "check_out_date": "2026-12-22",
    "guest_count": 2
}

### 15. Guest - Get My Reservations (M4/M6 - SF-8)
GET {{baseUrl}}/reservations/me
Authorization: Bearer {{token}}

### 16. Guest - Get Reservation Detail by ID (M4/M6 - SF-6, BR-15)
GET {{baseUrl}}/reservations/1
Authorization: Bearer {{token}}

### 16b. Guest - Download PDF Invoice (M6 - SF-9, BR-15)
GET {{baseUrl}}/reservations/1/invoice
Authorization: Bearer {{token}}

### 16c. Guest - Manually Cancel Pending Reservation (M6 - SF-8, BR-08)
POST {{baseUrl}}/reservations/1/cancel
Authorization: Bearer {{token}}

### 17. Guest - Initiate / Reuse Midtrans Snap Payment (M5 - SF-7)
POST {{baseUrl}}/reservations/1/pay
Authorization: Bearer {{token}}

### 18. Guest - Sync Payment Status from Midtrans API (M5 - SF-7)
POST {{baseUrl}}/reservations/1/sync
Authorization: Bearer {{token}}

### 19. Public - Midtrans Webhook Notification (M5 - SF-7, BR-09)
POST {{baseUrl}}/payments/webhook
Content-Type: application/json

{
    "order_id": "HSR-20261112-XXXX",
    "status_code": "200",
    "gross_amount": "1700000.00",
    "signature_key": "sha512_signature_key_from_midtrans",
    "transaction_status": "settlement",
    "payment_type": "bank_transfer",
    "transaction_id": "midtrans-sample-tx-id"
}
