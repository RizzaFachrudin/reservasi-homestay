@baseUrl = http://localhost:5000/api

### 1. Health Check
GET http://localhost:5000/health

### 2. Register User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "name": "Testing User",
    "email": "testing@example.com",
    "password": "password123",
    "phone": "081234567890"
}

### 3. Login User
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "testing@example.com",
    "password": "password123"
}

### 4. Get Profile (Protected)
@token = {{login.response.body.data.token}}
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### 5. Login Admin
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "admin@homestay.com",
    "password": "admin123"
}

@adminToken = {{loginAdmin.response.body.data.token}}

### 6. Public - Get Facilities
GET {{baseUrl}}/facilities

### 7. Public - Get Rooms (Catalog)
GET {{baseUrl}}/rooms

### 8. Public - Get Featured Rooms
GET {{baseUrl}}/rooms?featured=true

### 9. Public - Get Room Detail
GET {{baseUrl}}/rooms/1

### 9b. Public - Search Available Rooms (M3 - SF-4, BR-03, BR-04, BR-05)
GET {{baseUrl}}/rooms/available?check_in=2026-12-01&check_out=2026-12-04&guests=2

### 9c. Public - Get Room Availability Calendar by Month (M3 - SF-4, BR-18)
GET {{baseUrl}}/rooms/1/availability?month=2026-12

### 10. Admin - Get All Facilities
GET {{baseUrl}}/admin/facilities
Authorization: Bearer {{adminToken}}

### 11. Admin - Create Facility
POST {{baseUrl}}/admin/facilities
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "name": "Kolam Renang",
    "icon": "waves"
}

### 12. Admin - Get All Rooms
GET {{baseUrl}}/admin/rooms
Authorization: Bearer {{adminToken}}

### 13. Admin - Create Room
POST {{baseUrl}}/admin/rooms
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "name": "Kamar Suite Sunset",
    "description": "Kamar dengan pemandangan matahari terbenam yang indah",
    "pricePerNight": 750000,
    "capacity": 3,
    "status": "Available",
    "facilityIds": [1, 2]
}
